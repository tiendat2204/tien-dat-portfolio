# Umami Cloud analytics (https://cloud.umami.is)
# Website ID: optional, defaults to the one in src/data/config.ts
# UMAMI_WEBSITE_ID=

# Insights data, pick one:
# 1) Free plan: share link id (Website > Edit > Share URL > the part after /share/).
#    Keep it out of git: it opens your whole dashboard.
# UMAMI_SHARE_ID=
# 2) Pro plan: API key (Settings > API keys). Server only, never prefix with NEXT_PUBLIC_.
# UMAMI_API_KEY=
